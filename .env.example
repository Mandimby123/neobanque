# ==============================================================================
# NÉOBANQUE CORE SYSTEM CONFIGURATION (.env)
# ==============================================================================

# Application
APP_NAME="NéoBanque Core Portal"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Sécurité & Tokens
SECRET_KEY="ba8f4491ad33375cf9291e268d85c5646ab8b8cc563c301fa0dabb5ec4b77e80"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
COOKIE_NAME="neobank_session"
COOKIE_SECURE=false

# Chiffrement PCI-DSS (Clé Fernet AES-256 Base64 URL-safe)
CARD_ENCRYPTION_KEY="HooHd-zYeuRqjmfbcvL3fQBr8WaHls8mVISfaIhen5A="

# Base de données (PostgreSQL asyncpg en prod, aiosqlite en dev)
DATABASE_URL="sqlite+aiosqlite:///./neobank.db"
# DATABASE_URL="postgresql+asyncpg://neouser:neopassword@postgres:5432/neobank"

# Cache & Idempotence
REDIS_URL="redis://localhost:6379/0"

# Connecteurs Bancaires & Monétiques
USE_MOCK_BANKING=true

# Core Banking System (CBS) - ISO 20022 & mTLS
CBS_API_URL="https://cbs-core.neobanque.internal/api/v1"
CBS_MTLS_CERT_PATH="./certs/cbs_client.crt"
CBS_MTLS_KEY_PATH="./certs/cbs_client.key"
CBS_TIMEOUT_SECONDS=10

# Card Management System (CMS) - Monétique & HMAC-SHA256
CMS_API_URL="https://cms-switch.neobanque.internal/api/v2"
CMS_HMAC_SECRET="cms_production_secret_hmac_key_2026_banking"
CMS_CLIENT_ID="NEO_CMS_CLIENT_FR01"
CMS_TIMEOUT_SECONDS=8

# Paramètres Bancaires Nationaux (France / SEPA)
DEFAULT_BANK_CODE="30004"
DEFAULT_BRANCH_CODE="02050"
DEFAULT_BIC="NEOBFRPPXXX"

